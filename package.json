{
  "name": "tbdname",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs"
  ],
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "accuracy": "npm run accuracy -w tbdname-server",
    "demo": "node examples/demo/serve.mjs",
    "docs:dev": "npm run dev -w tbdname-docs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "happy-dom": "21.0.4",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.40.0",
    "vitest": "4.1.12"
  },
  "overrides": {
    "fastify": "5.12.7"
  }
}
