generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Project {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @db.VarChar(200)
  retentionDays  Int               @default(30)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  keys           ApiKey[]
  visitors       Visitor[]
  webhooks       WebhookEndpoint[]
  members        ProjectMember[]
  componentStats ComponentStat[]
  fraudModels    FraudModel[]
  nonces         RequestNonce[]

  @@map("projects")
}

enum ApiKeyType {
  public
  secret

  @@map("api_key_type")
}

model ApiKey {
  id             String     @id @default(uuid()) @db.Uuid
  projectId      String     @db.Uuid
  type           ApiKeyType
  name           String?    @db.VarChar(200)
  prefix         String     @unique @db.VarChar(16)
  hash           String     @db.Char(64)
  allowedOrigins String[]   @default([])
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime?  @db.Timestamptz(3)
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("api_keys")
}

model Visitor {
  id            String            @id @db.VarChar(32)
  projectId     String            @db.Uuid
  firstSeenAt   DateTime          @db.Timestamptz(3)
  lastSeenAt    DateTime          @db.Timestamptz(3)
  signalSummary Json
  eventCount    Int               @default(0)
  /// Shared by every browser on one device; see CrossBrowserService.resolveDeviceId. Null on rows from before it existed.
  deviceId      String?           @db.VarChar(32)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buckets       VisitorBucket[]
  events        Event[]
  deliveries    WebhookDelivery[]
  devices       DeviceProfile[]
  accounts      VisitorAccount[]
  labels        EventLabel[]

  @@index([projectId, lastSeenAt])
  @@index([projectId, deviceId])
  @@map("visitors")
}

// Cross-browser linking: the latest device profile of each visitor on each network it used. netHash is a keyed
// hash of the IPv4 /24 or IPv6 /64, never the address. Rows go when the visitor goes (retention, deletion).
model DeviceProfile {
  visitorId  String   @db.VarChar(32)
  netHash    String   @db.Char(32)
  projectId  String   @db.Uuid
  coreHash   String?  @db.Char(28)
  browser    String   @db.VarChar(16)
  profile    Json
  lastSeenAt DateTime @db.Timestamptz(3)
  visitor    Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@id([visitorId, netHash])
  @@index([projectId, netHash, lastSeenAt])
  @@index([projectId, coreHash])
  @@map("device_profiles")
}

// Accounts (the customer's linkedId) seen with each visitor, for multiAccount / accountSharing and the device graph.
// Rows go when the visitor goes, or when lastSeenAt falls out of retention.
model VisitorAccount {
  visitorId   String   @db.VarChar(32)
  linkedId    String   @db.VarChar(256)
  projectId   String   @db.Uuid
  firstSeenAt DateTime @db.Timestamptz(3)
  lastSeenAt  DateTime @db.Timestamptz(3)
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@id([visitorId, linkedId])
  @@index([projectId, linkedId, lastSeenAt])
  @@map("visitor_accounts")
}

// How many visitors of a project share each component value, for the linkage matcher. Rebuilt from visitors by the
// maintenance job; values seen on a single visitor are left out (the matcher treats missing values as rare).
// component "_total" / value "_" holds the visitor count.
model ComponentStat {
  projectId String  @db.Uuid
  component String  @db.VarChar(24)
  value     String  @db.VarChar(64)
  visitors  Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, component, value])
  @@map("component_stats")
}

model VisitorBucket {
  projectId  String   @db.Uuid
  bucketHash String   @db.Char(64)
  visitorId  String   @db.VarChar(32)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  visitor    Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@id([projectId, bucketHash, visitorId])
  @@index([visitorId])
  @@map("visitor_buckets")
}

model MaintenanceLease {
  name   String   @id @db.VarChar(64)
  holder String   @db.VarChar(64)
  until  DateTime @db.Timestamptz(3)

  @@map("maintenance_leases")
}

/// Range-partitioned by month on createdAt (see the init migration); the primary key
/// includes createdAt because Postgres requires the partition key in unique constraints.
model Event {
  id           String   @db.Uuid
  createdAt    DateTime @db.Timestamptz(3)
  projectId    String   @db.Uuid
  visitorId    String   @db.VarChar(32)
  matchKind    String   @db.VarChar(16)
  confidence   Float
  suspectScore Int      @db.SmallInt
  reasons      Json
  signals      Json
  ip           String?  @db.VarChar(64)
  asn          Int?
  country      String?  @db.Char(2)
  tags         Json?
  linkedId     String?  @db.VarChar(256)
  visitor      Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([projectId, createdAt])
  @@index([visitorId, createdAt])
  @@index([projectId, linkedId, createdAt])
  @@map("events")
}

/// A customer's verdict on an event for one fraud type. The signals that fired are copied here, so training data
/// outlives event retention; deleting the visitor deletes its labels.
model EventLabel {
  projectId String   @db.Uuid
  eventId   String   @db.Uuid
  label     String   @db.VarChar(32)
  fraud     Boolean
  visitorId String   @db.VarChar(32)
  detected  String[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@id([projectId, eventId, label])
  @@index([projectId, label, updatedAt])
  @@index([visitorId])
  @@map("event_labels")
}

/// Request nonces seen in the last 24 hours, for replay detection. Random values, no personal data.
model RequestNonce {
  projectId String   @db.Uuid
  nonce     String   @db.Char(32)
  createdAt DateTime @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, nonce])
  @@index([createdAt])
  @@map("request_nonces")
}

/// The trained model for one fraud type (FraudModel in @trace-id/signals/fraud-score).
model FraudModel {
  projectId String   @db.Uuid
  label     String   @db.VarChar(32)
  model     Json
  trainedAt DateTime @db.Timestamptz(3)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, label])
  @@map("fraud_models")
}

model WebhookEndpoint {
  id            String            @id @default(uuid()) @db.Uuid
  projectId     String            @db.Uuid
  url           String            @db.VarChar(2048)
  /// AES-256-GCM encrypted with a key derived from TOKEN_SECRET; needed in clear to sign.
  secretEnc     String            @db.VarChar(256)
  events        String[]
  flagThreshold Int               @default(70)
  enabled       Boolean           @default(true)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@index([projectId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String          @id @db.Uuid
  endpointId    String          @db.Uuid
  visitorId     String          @db.VarChar(32)
  eventId       String          @db.Uuid
  type          String          @db.VarChar(32)
  payload       Json
  status        String          @default("pending") @db.VarChar(16)
  attempts      Int             @default(0)
  nextAttemptAt DateTime        @db.Timestamptz(3)
  lockedUntil   DateTime?       @db.Timestamptz(3)
  lastStatus    Int?
  lastError     String?         @db.VarChar(200)
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  deliveredAt   DateTime?       @db.Timestamptz(3)
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  visitor       Visitor         @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([visitorId])
  @@map("webhook_deliveries")
}

enum ProjectRole {
  owner
  admin
  viewer

  @@map("project_role")
}

model ProjectMember {
  projectId String      @db.Uuid
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// Dashboard accounts, managed by Better Auth (email + password).

model User {
  id            String          @id
  name          String
  email         String          @unique
  emailVerified Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  memberships   ProjectMember[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}
