DATABASE_URL=postgresql://trace:trace@localhost:5432/trace
REDIS_URL=redis://localhost:6379
# At least 32 random characters, e.g. `openssl rand -base64 48`
TOKEN_SECRET=change-me-change-me-change-me-change-me
# Dashboard session signing secret, different from TOKEN_SECRET
AUTH_SECRET=change-me-too-change-me-too-change-me-too
DASHBOARD_URL=http://localhost:3000
# DASHBOARD_ALLOW_SIGNUP=false   # first account is always allowed
PORT=8080
TRUST_PROXY=false
IP_STORAGE=truncated
EVENT_VERIFY_WINDOW_MINUTES=60
# IP data: `npm run ip-data -- /data/ip` downloads free lists and databases and prints these settings. Changed files
# are reloaded within 10 minutes.
# Optional operator-supplied lists, one IP or CIDR per line
# TOR_EXIT_LIST_FILE=/data/tor-exits.txt
# DATACENTER_CIDR_FILE=/data/datacenter-cidrs.txt
# IP_BLOCKLIST_FILE=/data/blocklist.txt
# WEBHOOK_TIMEOUT_MS=5000
# Development only: allow http:// and private-network webhook targets
# WEBHOOK_ALLOW_INSECURE=false
# DATACENTER_ASN_FILE=/data/datacenter-asns.txt
# Operator-supplied MaxMind-format databases (never bundled)
# GEOIP_COUNTRY_DB=/data/GeoLite2-Country.mmdb
# GEOIP_ASN_DB=/data/GeoLite2-ASN.mmdb
# Signed AI agents (Web Bot Auth): trusted key directories, comma separated; 'off' disables.
# AGENT_DIRECTORIES=https://chatgpt.com
# Proxy exit ranges for the proxy signal, one IP or CIDR per line.
# PROXY_CIDR_FILE=/data/proxy.txt
# Published IP ranges of crawlers and AI agents (GPTBot, ChatGPT, PerplexityBot, Googlebot, Bingbot...), written by
# `npm run crawler-ranges -- /data/crawler-ranges.json` (run it daily). A claimed crawler outside its ranges is an impostor.
# CRAWLER_RANGES_FILE=/data/crawler-ranges.json
# IP data providers, highest priority first (see docs/configuration.md#ip-data-providers). Each receives visitor IPs.
# IP_PROVIDERS=ipqualityscore,ipinfo
# IPQS_KEY=
# IPINFO_TOKEN=
# IP_PROVIDER_TIMEOUT_MS=400
# IP_PROVIDER_CACHE_HOURS=24
