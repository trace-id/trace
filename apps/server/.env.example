DATABASE_URL=postgresql://tbdname:tbdname@localhost:5432/tbdname
REDIS_URL=redis://localhost:6379
# At least 32 random characters, e.g. `openssl rand -base64 48`
TOKEN_SECRET=change-me-change-me-change-me-change-me
PORT=8080
TRUST_PROXY=false
IP_STORAGE=truncated
EVENT_VERIFY_WINDOW_MINUTES=60
# Optional operator-supplied lists, one IP or CIDR per line
# TOR_EXIT_LIST_FILE=/data/tor-exits.txt
# DATACENTER_CIDR_FILE=/data/datacenter-cidrs.txt
# IP_BLOCKLIST_FILE=/data/blocklist.txt
