{
  "name": "tbdname-server",
  "version": "0.1.0",
  "private": true,
  "description": "Ingest, identification, verification API.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "db:deploy": "prisma migrate deploy",
    "keys:create": "tsx src/scripts/create-keys.ts",
    "accuracy": "tsx src/accuracy/run-accuracy.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "@prisma/client": "6.19.3",
    "@tbdname/signals": "0.1.0",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.13.21",
    "@tbdname/sdk-node": "0.1.0",
    "tsx": "4.23.15",
    "unplugin-swc": "1.6.0"
  }
}
