{
  "name": "trace-server",
  "version": "0.1.0",
  "private": true,
  "description": "Ingest, identification, verification API.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "prisma generate && node scripts/dev.mjs",
    "db:deploy": "prisma migrate deploy",
    "keys:create": "tsx src/scripts/create-keys.ts",
    "accuracy": "tsx src/accuracy/run-accuracy.ts",
    "tune": "tsx src/scripts/tune-weights.ts",
    "crawler-ranges": "tsx src/scripts/fetch-crawler-ranges.ts",
    "ip-data": "tsx src/scripts/fetch-ip-data.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@trace-id/embed": "0.1.0",
    "@trace-id/ip-intel": "0.1.0",
    "@trace-id/sdk-js": "0.1.0",
    "@trace-id/sdk-node": "0.1.0",
    "@trace-id/signals": "0.1.0",
    "better-auth": "1.7.14",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "mmdb-lib": "3.0.3",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.13.21",
    "@trace-id/sdk-react-native": "0.1.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "unplugin-swc": "1.6.0"
  }
}
