{
  "name": "@trace-id/sdk-next",
  "version": "0.1.1",
  "description": "Next.js integration for Trace: a client provider for the App Router and a guard for route handlers and server actions.",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "app-router",
    "fraud",
    "device-identification",
    "trace"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/sdk-node": "0.1.1",
    "@trace-id/sdk-react": "0.1.1"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@trace-id/signals": "0.1.1",
    "@types/react": "19.3.0",
    "react": "19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-id/trace.git",
    "directory": "packages/sdk-next"
  },
  "homepage": "https://github.com/trace-id/trace/tree/main/packages/sdk-next#readme",
  "bugs": {
    "url": "https://github.com/trace-id/trace/issues"
  }
}
