    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/sdk-js": "0.1.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@trace-id/signals": "0.1.0",
    "happy-dom": "21.0.4",
    "vue": "3.5.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
