{
  "name": "@trace-id/sdk-vue",
  "version": "0.1.1",
  "description": "Vue 3 bindings for Trace: createIdentify() plugin and useVisitorData() composable.",
  "license": "MIT",
  "keywords": [
    "vue",
    "nuxt",
    "fraud",
    "device-identification",
    "trace"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/sdk-js": "0.1.1"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@trace-id/signals": "0.1.1",
    "happy-dom": "21.0.4",
    "vue": "3.5.46"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-id/trace.git",
    "directory": "packages/sdk-vue"
  },
  "homepage": "https://github.com/trace-id/trace/tree/main/packages/sdk-vue#readme",
  "bugs": {
    "url": "https://github.com/trace-id/trace/issues"
  }
}
