{
  "name": "@trace-id/proxy-cloudflare",
  "version": "0.1.1",
  "description": "Cloudflare Worker that serves Trace from your own domain (first-party mode), with real client IPs and JA4.",
  "license": "MIT",
  "keywords": [
    "cloudflare",
    "worker",
    "proxy",
    "first-party",
    "trace"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-id/trace.git",
    "directory": "packages/proxy-cloudflare"
  },
  "homepage": "https://github.com/trace-id/trace/tree/main/packages/proxy-cloudflare#readme",
  "bugs": {
    "url": "https://github.com/trace-id/trace/issues"
  }
}
