{
  "name": "@trace-id/sdk-svelte",
  "version": "0.1.0",
  "description": "Svelte store for Trace: createVisitorData(). No Svelte import, so it also works with Angular's async pipe or Solid.",
  "license": "MIT",
  "keywords": [
    "svelte",
    "sveltekit",
    "angular",
    "fraud",
    "device-identification",
    "trace"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/sdk-js": "0.1.0"
  },
  "devDependencies": {
    "@trace-id/signals": "0.1.0",
    "happy-dom": "21.0.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
