{
  "name": "@trace-id/sdk-node",
  "version": "0.1.0",
  "description": "Server helper: verify identification events with your secret key.",
  "license": "MIT",
  "keywords": [
    "fraud",
    "device-identification",
    "webhook",
    "trace",
    "express",
    "fastify",
    "nextjs",
    "middleware"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "exports": {
    ".": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./sealed": {
      "types": "./dist/sealed.d.ts",
      "default": "./dist/sealed.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "default": "./dist/webhooks.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "default": "./dist/agents.js"
    },
    "./crawlers": {
      "types": "./dist/crawlers.d.ts",
      "default": "./dist/crawlers.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/signals": "0.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "fastify": "5.12.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-id/trace.git",
    "directory": "packages/sdk-node"
  },
  "homepage": "https://github.com/trace-id/trace/tree/main/packages/sdk-node#readme",
  "bugs": {
    "url": "https://github.com/trace-id/trace/issues"
  }
}
