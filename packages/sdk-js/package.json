{
  "name": "@tbdname/sdk-js",
  "version": "0.1.0",
  "description": "Browser SDK: collects device signals and calls the identify endpoint.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./collect": {
      "types": "./dist/collect.d.ts",
      "default": "./dist/collect.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./browser": {
      "types": "./dist/client.d.ts",
      "default": "./dist/browser/sdk.esm.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@tbdname/signals": "0.1.0"
  },
  "devDependencies": {
    "happy-dom": "18.0.1",
    "esbuild": "0.28.2"
  }
}
