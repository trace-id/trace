{
  "name": "@trace-id/sdk-js",
  "version": "0.1.0",
  "description": "Browser SDK: collects device signals and calls the identify endpoint.",
  "license": "MIT",
  "keywords": [
    "fraud",
    "device-identification",
    "browser-fingerprint",
    "bot-detection",
    "trace"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./collect": {
      "types": "./dist/collect.d.ts",
      "default": "./dist/collect.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./browser": {
      "types": "./dist/client.d.ts",
      "default": "./dist/browser/sdk.esm.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/signals": "0.1.0"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "esbuild": "0.28.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-id/trace.git",
    "directory": "packages/sdk-js"
  },
  "homepage": "https://github.com/trace-id/trace/tree/main/packages/sdk-js#readme",
  "bugs": {
    "url": "https://github.com/trace-id/trace/issues"
  }
}
