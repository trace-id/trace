{
  "name": "@trace-id/sdk-solid",
  "version": "0.1.1",
  "description": "SolidJS bindings for Trace: <IdentifyProvider> and createVisitorData().",
  "license": "MIT",
  "keywords": [
    "solid",
    "solidjs",
    "solidstart",
    "fraud",
    "device-identification",
    "trace"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/sdk-js": "0.1.1"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@trace-id/signals": "0.1.1",
    "happy-dom": "21.0.4",
    "solid-js": "1.9.20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-id/trace.git",
    "directory": "packages/sdk-solid"
  },
  "homepage": "https://github.com/trace-id/trace/tree/main/packages/sdk-solid#readme",
  "bugs": {
    "url": "https://github.com/trace-id/trace/issues"
  }
}
