{
  "name": "@trace-id/sdk-solid",
  "version": "0.1.0",
  "description": "SolidJS bindings for Trace: <IdentifyProvider> and createVisitorData().",
  "license": "MIT",
  "keywords": ["solid", "solidjs", "solidstart", "fraud", "device-identification", "trace"],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/sdk-js": "0.1.0"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0"
  },
  "devDependencies": {
    "@trace-id/signals": "0.1.0",
    "happy-dom": "21.0.4",
    "solid-js": "1.9.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
