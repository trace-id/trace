{
  "name": "@trace-id/signals",
  "version": "0.1.0",
  "description": "Shared signal definitions, payload types and scoring helpers.",
  "license": "MIT",
  "keywords": [
    "fraud",
    "device-intelligence",
    "fingerprint",
    "trace"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./hash": {
      "types": "./dist/hash.d.ts",
      "default": "./dist/hash.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./definitions": {
      "types": "./dist/definitions.d.ts",
      "default": "./dist/definitions.js"
    },
    "./scoring": {
      "types": "./dist/scoring.d.ts",
      "default": "./dist/scoring.js"
    },
    "./similarity": {
      "types": "./dist/similarity.d.ts",
      "default": "./dist/similarity.js"
    },
    "./crossbrowser": {
      "types": "./dist/crossbrowser.d.ts",
      "default": "./dist/crossbrowser.js"
    },
    "./ua": {
      "types": "./dist/ua.d.ts",
      "default": "./dist/ua.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./timezones": {
      "types": "./dist/timezones.d.ts",
      "default": "./dist/timezones.js"
    },
    "./tzoffset": {
      "types": "./dist/tzoffset.d.ts",
      "default": "./dist/tzoffset.js"
    },
    "./antidetect": {
      "types": "./dist/antidetect.d.ts",
      "default": "./dist/antidetect.js"
    },
    "./tls": {
      "types": "./dist/tls.d.ts",
      "default": "./dist/tls.js"
    },
    "./linkage": {
      "types": "./dist/linkage.d.ts",
      "default": "./dist/linkage.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "default": "./dist/agents.js"
    },
    "./web-bot-auth": {
      "types": "./dist/web-bot-auth.d.ts",
      "default": "./dist/web-bot-auth.js"
    },
    "./geo": {
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.js"
    },
    "./rarity": {
      "types": "./dist/rarity.d.ts",
      "default": "./dist/rarity.js"
    },
    "./integrity": {
      "types": "./dist/integrity.d.ts",
      "default": "./dist/integrity.js"
    },
    "./fraud-score": {
      "types": "./dist/fraud-score.d.ts",
      "default": "./dist/fraud-score.js"
    },
    "./network": {
      "types": "./dist/network.d.ts",
      "default": "./dist/network.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-id/trace.git",
    "directory": "packages/signals"
  },
  "homepage": "https://github.com/trace-id/trace/tree/main/packages/signals#readme",
  "bugs": {
    "url": "https://github.com/trace-id/trace/issues"
  }
}
