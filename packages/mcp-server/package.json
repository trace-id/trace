{
  "name": "@trace-id/mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol server for Trace: let AI agents look up events, explain verdicts and investigate devices.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "fraud",
    "trace"
  ],
  "type": "module",
  "bin": {
    "trace-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/signals": "0.1.1"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trace-id/trace.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/trace-id/trace/tree/main/packages/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/trace-id/trace/issues"
  }
}
