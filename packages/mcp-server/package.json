{
  "name": "@trace-id/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Trace: let AI agents look up events, explain verdicts and investigate devices.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "fraud",
    "trace"
  ],
  "type": "module",
  "bin": {
    "trace-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/signals": "0.1.0"
  },
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
