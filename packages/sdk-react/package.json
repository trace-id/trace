{
  "name": "@trace-id/sdk-react",
  "version": "0.1.0",
  "description": "React bindings: <IdentifyProvider> and useVisitorData().",
  "license": "MIT",
  "keywords": [
    "react",
    "fraud",
    "device-identification",
    "trace"
  ],
