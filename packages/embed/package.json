{
  "name": "@trace-id/embed",
  "version": "0.1.0",
  "description": "Trace inside your own backend: device identification and fraud signals with no separate server. Plug in your database (MongoDB, Postgres) and framework (Express, Fastify, NestJS, Next.js).",
  "license": "AGPL-3.0-only",
  "keywords": [
    "fraud",
    "device-identification",
    "bot-detection",
    "multi-accounting",
    "trace"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18.17"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mongo": {
      "types": "./dist/storage/mongo.d.ts",
      "default": "./dist/storage/mongo.js"
    },
    "./postgres": {
      "types": "./dist/storage/postgres.d.ts",
      "default": "./dist/storage/postgres.js"
    },
    "./fetch": {
      "types": "./dist/http/fetch.d.ts",
      "default": "./dist/http/fetch.js"
    },
    "./node": {
      "types": "./dist/http/node.d.ts",
      "default": "./dist/http/node.js"
    },
    "./fastify": {
      "types": "./dist/http/fastify.d.ts",
      "default": "./dist/http/fastify.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@trace-id/sdk-node": "0.1.0",
    "@trace-id/signals": "0.1.0",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
