# ./setup.sh (or .\setup.ps1) writes docker/.env for you. By hand: copy this file and set each secret to 32+ random
# letters and digits, e.g. openssl rand -hex 32 (base64 output can contain / and +, which break the database URL).
POSTGRES_PASSWORD=
TOKEN_SECRET=
AUTH_SECRET=
# TRUST_PROXY=10.0.0.0/8   # behind a reverse proxy: list its IPs/CIDRs (hop counts are refused)
# IP_STORAGE=truncated     # full | truncated | hashed | none
# SERVER_PORT=8080
# DASHBOARD_PORT=3000
# DASHBOARD_URL=http://localhost:3000   # public URL of the dashboard (https in production)
